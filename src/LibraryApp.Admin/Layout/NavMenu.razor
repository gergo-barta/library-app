@inject AdminAuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">LibraryApp Admin</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        @if (_loggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="books">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Books
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="readers">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Readers
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="loans">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Loans
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reviews">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Reviews
                </NavLink>
            </div>
            <div class="nav-item px-3 mt-3">
                <button class="btn btn-sm btn-warning w-100" @onclick="LogoutAsync">Sign out</button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sign in
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool _loggedIn;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override async Task OnInitializedAsync()
    {
        _loggedIn = await Auth.IsLoggedInAsync();
        Nav.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var newState = await Auth.IsLoggedInAsync();
        if (newState != _loggedIn)
        {
            _loggedIn = newState;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        _loggedIn = false;
        Nav.NavigateTo("login");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
