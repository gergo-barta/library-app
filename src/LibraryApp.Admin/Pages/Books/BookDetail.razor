@page "/books/{Id:int}"
@inject IBookApiClient BookApi
@inject IReviewApiClient ReviewApi
@inject AdminAuthService Auth
@inject NavigationManager Nav

<PageTitle>Book detail</PageTitle>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_book is null)
{
    <div class="alert alert-warning">Book not found.</div>
}
else
{
    <h2>@_book.Title</h2>
    <dl class="row">
        <dt class="col-sm-3">Inventory #</dt>
        <dd class="col-sm-9">@_book.InventoryNumber</dd>
        <dt class="col-sm-3">Author</dt>
        <dd class="col-sm-9">@_book.Author</dd>
        <dt class="col-sm-3">Publisher</dt>
        <dd class="col-sm-9">@_book.Publisher</dd>
        <dt class="col-sm-3">Year</dt>
        <dd class="col-sm-9">@_book.PublicationYear</dd>
        <dt class="col-sm-3">Average rating</dt>
        <dd class="col-sm-9">@(_book.AverageRating.HasValue ? $"{_book.AverageRating:F1} / 5 ({_book.ReviewCount} reviews)" : "No reviews yet")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(_book.IsAvailable ? "Available" : "On loan")</dd>
    </dl>

    <a class="btn btn-outline-primary me-2" href="@($"books/{_book.InventoryNumber}/edit")">Edit</a>
    <a class="btn btn-secondary" href="books">Back</a>

    <h4 class="mt-4">Reviews</h4>
    @if (_reviews.Count == 0)
    {
        <p>No reviews yet.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var review in _reviews)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between">
                        <strong>@review.ReaderName</strong>
                        <span>@review.Score / 5 — @review.CreatedAt.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div>@review.Text</div>
                    <button class="btn btn-sm btn-outline-danger mt-2" @onclick="() => DeleteReview(review)">Delete</button>
                </li>
            }
        </ul>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private BookDTO? _book;
    private List<ReviewDTO> _reviews = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!await Auth.IsLoggedInAsync())
        {
            Nav.NavigateTo("login", replace: true);
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _book = await BookApi.GetByIdAsync(Id);
            if (_book is not null)
            {
                var reviews = await ReviewApi.GetByBookAsync(Id);
                _reviews = reviews.ToList();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteReview(ReviewDTO review)
    {
        var response = await ReviewApi.DeleteAsync(review.Id);
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await Auth.LogoutAsync();
            Nav.NavigateTo("login", replace: true);
        }
    }
}
